---
import type { GetStaticPaths } from 'astro';
import PostList from '@/components/blog/PostList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/lib/format';
import { getArchives, getPostsByYearMonth, type Post } from '@/lib/posts';

export const getStaticPaths = (async () => {
  const archives = await getArchives();

  return Promise.all(
    archives.flatMap(({ year, months }) =>
      months.map(async ({ month }) => ({
        params: { year: String(year), month: String(month).padStart(2, '0') },
        props: { year, month, posts: await getPostsByYearMonth(year, month) },
      })),
    ),
  );
}) satisfies GetStaticPaths;

const { year, month, posts } = Astro.props as { year: number; month: number; posts: Post[] };
---

<BaseLayout
  title={`${year}年${month}月`}
  description={`${year}年${month}月に投稿した記事の一覧。`}
>
  <h1>{year}年{month}月</h1>
  <p class="muted">{posts.length} 件の記事</p>
  <PostList posts={posts} />
  <p class="back"><a href={href(`/blog/${year}`)}>← {year}年に戻る</a></p>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.25rem;
  }

  .back {
    margin-top: 2rem;
  }
</style>
