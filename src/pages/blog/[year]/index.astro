---
import type { GetStaticPaths } from 'astro';
import PostList from '@/components/blog/PostList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/lib/format';
import { getArchives, getPostsByYearMonth, type Post } from '@/lib/posts';

export const getStaticPaths = (async () => {
  const archives = await getArchives();

  return Promise.all(
    archives.map(async ({ year }) => ({
      params: { year: String(year) },
      props: { year, posts: await getPostsByYearMonth(year) },
    })),
  );
}) satisfies GetStaticPaths;

const { year, posts } = Astro.props as { year: number; posts: Post[] };
---

<BaseLayout title={`${year}年`} description={`${year}年に投稿した記事の一覧。`}>
  <h1>{year}年</h1>
  <p class="muted">{posts.length} 件の記事</p>
  <PostList posts={posts} />
  <p class="back"><a href={href('/blog')}>← 記事一覧に戻る</a></p>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.25rem;
  }

  .back {
    margin-top: 2rem;
  }
</style>
