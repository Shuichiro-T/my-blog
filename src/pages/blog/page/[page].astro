---
import type { GetStaticPaths } from 'astro';
import Pagination from '@/components/blog/Pagination.astro';
import PostList from '@/components/blog/PostList.astro';
import { POSTS_PER_PAGE } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts, type Post } from '@/lib/posts';

/**
 * 2ページ目以降だけをここで生成する（1ページ目は /blog）。
 * URL は /blog/page/2, /blog/page/3, ...
 */
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const lastPage = Math.ceil(posts.length / POSTS_PER_PAGE);

  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        page,
        lastPage,
      },
    };
  });
}) satisfies GetStaticPaths;

const { posts, page, lastPage } = Astro.props as {
  posts: Post[];
  page: number;
  lastPage: number;
};
---

<BaseLayout title={`Blog (${page}ページ目)`} description="記事の一覧。">
  <h1>Blog</h1>
  <PostList posts={posts} />
  <Pagination
    prevPath={page === 2 ? '/blog' : `/blog/page/${page - 1}`}
    nextPath={page < lastPage ? `/blog/page/${page + 1}` : undefined}
    current={page}
    last={lastPage}
  />
</BaseLayout>
