---
import { SITE_TITLE } from '@/consts';
import { href } from '@/lib/format';
import { PALETTE_IDS, PALETTE_STORAGE_KEY } from '@/lib/palettes';
import { THEME_IDS, THEME_STORAGE_KEY } from '@/lib/theme';

interface Props {
  title: string;
  description: string;
  /** OGP の og:type。記事ページでは 'article' を渡す */
  type?: 'website' | 'article';
}

const { title, description, type = 'website' } = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<script is:inline define:vars={{ PALETTE_IDS, PALETTE_STORAGE_KEY, THEME_IDS, THEME_STORAGE_KEY }}>
  try {
    const storedPalette = localStorage.getItem(PALETTE_STORAGE_KEY);
    if (storedPalette && PALETTE_IDS.includes(storedPalette)) {
      document.documentElement.dataset.palette = storedPalette;
    }
    const storedTheme = localStorage.getItem(THEME_STORAGE_KEY);
    if (storedTheme && THEME_IDS.includes(storedTheme)) {
      document.documentElement.dataset.theme = storedTheme;
    }
  } catch {
    // localStorage が使えない環境（プライベートモード等）では既定色のままにする
  }
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={href('/rss.xml')}
/>

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta name="twitter:card" content="summary" />
