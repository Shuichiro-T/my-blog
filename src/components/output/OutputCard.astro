---
import FormattedDate from '@/components/common/FormattedDate.astro';
import Tag from '@/components/common/Tag.astro';
import { OUTPUT_TYPES } from '@/consts';
import type { Output } from '@/lib/outputs';

interface Props {
  output: Output;
}

const { output } = Astro.props;
const { type, embedId, ogImage, url, title, pubDate, tags } = output.data;
---

<article class="card">
  <div class="meta">
    <FormattedDate date={pubDate} />
    <span class="type">{OUTPUT_TYPES[type]}</span>
  </div>
  <h2><a href={url} target="_blank" rel="noopener noreferrer">{title}</a></h2>

  {type === 'speakerdeck' && embedId && (
    <div class="embed">
      <iframe
        class="speakerdeck-iframe"
        src={`https://speakerdeck.com/player/${embedId}`}
        title={title}
        allowfullscreen
        loading="lazy"
      />
    </div>
  )}

  {type !== 'speakerdeck' && ogImage && (
    <a href={url} target="_blank" rel="noopener noreferrer" class="og-link">
      <img src={ogImage} alt={title} class="og-image" loading="lazy" />
    </a>
  )}

  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <Tag tag={tag} />
        ))}
      </div>
    )
  }
</article>

<style>
  .card {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .type {
    padding: 0 0.4rem;
    border: 1px solid currentColor;
    border-radius: 4px;
  }

  h2 {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  h2 a {
    color: var(--color-fg);
  }

  .embed {
    margin-block: 0.75rem;
    aspect-ratio: 560 / 315;
    width: 100%;
  }

  .speakerdeck-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 6px;
  }

  .og-link {
    display: block;
    margin-block: 0.75rem;
  }

  .og-image {
    width: 100%;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
