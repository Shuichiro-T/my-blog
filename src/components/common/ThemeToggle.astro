---
import { DEFAULT_THEME_ID, THEMES, THEME_STORAGE_KEY } from '@/lib/theme';
---

<div class="theme-switcher">
  <label for="theme-select" class="visually-hidden">表示モード</label>
  <select id="theme-select">
    {THEMES.map((theme) => <option value={theme.id}>{theme.label}</option>)}
  </select>
</div>

<script is:inline define:vars={{ DEFAULT_THEME_ID, THEME_STORAGE_KEY }}>
  const select = document.getElementById('theme-select');
  if (select) {
    select.value = document.documentElement.dataset.theme || DEFAULT_THEME_ID;
    select.addEventListener('change', () => {
      const value = select.value;
      document.documentElement.dataset.theme = value;
      try {
        localStorage.setItem(THEME_STORAGE_KEY, value);
      } catch {
        // localStorage が使えない環境（プライベートモード等）では保存をあきらめる
      }
    });
  }
</script>

<style>
  .theme-switcher select {
    font: inherit;
    font-size: 0.875rem;
    color: var(--color-fg);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.25rem 0.5rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
