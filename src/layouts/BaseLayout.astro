---
import Archive from '@/components/blog/Archive.astro';
import BaseHead from '@/components/layout/BaseHead.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { SITE_LANG } from '@/consts';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  /** OGP 画像の絶対 URL。省略した場合は画像なしのカードになる */
  image?: string;
  /** OGP 画像の代替テキスト */
  imageAlt?: string;
}

const { title, description, type, image, imageAlt } = Astro.props;
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <BaseHead
      title={title}
      description={description}
      type={type}
      image={image}
      imageAlt={imageAlt}
    />
  </head>
  <body>
    <Header />
    <div class="page">
      <aside class="sidebar sidebar-left">
        <Archive />
      </aside>
      <main class="container">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>

<style>
  main {
    padding-block: 2.5rem;
  }

  .sidebar {
    display: none;
  }

  /* PC 幅のときだけ、記事アーカイブを左サイドバーとして表示する */
  @media (min-width: 1024px) {
    .page {
      display: grid;
      grid-template-columns: 220px minmax(0, var(--content-width));
      justify-content: center;
      align-items: start;
      gap: 2.5rem;
      max-width: calc(220px + 2.5rem + var(--content-width) + 2.5rem);
      margin-inline: auto;
      padding-inline: 1.25rem;
    }

    .sidebar-left {
      display: block;
      padding-block: 2.5rem;
      position: sticky;
      top: 1.5rem;
    }

    .page .container {
      max-width: none;
      padding-inline: 0;
      margin-inline: 0;
    }
  }
</style>
